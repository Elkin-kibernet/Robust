<Application x:Class="RobloxWorker.Launcher.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:RobloxWorker.Launcher"
             StartupUri="MainWindow.xaml">
    <Application.Resources>
        <!-- Тёмная тема (по умолчанию) -->
        <SolidColorBrush x:Key="BgMain" Color="#0D1117"/>
        <SolidColorBrush x:Key="BgCard" Color="#161B22"/>
        <SolidColorBrush x:Key="BgCardAlt" Color="#1E2530"/>
        <SolidColorBrush x:Key="BgInput" Color="#0B1017"/>
        <SolidColorBrush x:Key="BorderSoft" Color="#2A3242"/>
        <SolidColorBrush x:Key="BorderStrong" Color="#3A4658"/>
        <SolidColorBrush x:Key="TextPrimary" Color="#F0F6FC"/>
        <SolidColorBrush x:Key="TextSecondary" Color="#9AA7B8"/>
        <SolidColorBrush x:Key="TextMuted" Color="#6B7A8D"/>
        <SolidColorBrush x:Key="Accent" Color="#10B981"/>
        <SolidColorBrush x:Key="AccentHover" Color="#34D399"/>
        <SolidColorBrush x:Key="AccentSoft" Color="#0F2E25"/>
        <SolidColorBrush x:Key="Danger" Color="#EF4444"/>
        <SolidColorBrush x:Key="DangerHover" Color="#F87171"/>
        <SolidColorBrush x:Key="Warning" Color="#F59E0B"/>
        <SolidColorBrush x:Key="Info" Color="#3B82F6"/>
        <SolidColorBrush x:Key="ChromeHover" Color="#22FFFFFF"/>
        <SolidColorBrush x:Key="ChromeCloseHover" Color="#E81123"/>
    </Application.Resources>
</Application>
