<Window x:Class="RobloxWorker.Launcher.ContractWarningWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Правила выполнения заданий"
        Height="640" Width="650"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        Background="#0F172A" Foreground="#F8FAFC"
        FontFamily="Segoe UI">

    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="BtnBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="BtnBorder" Property="Opacity" Value="0.88"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="BtnBorder" Property="Opacity" Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Заголовок -->
        <Border Grid.Row="0" Background="#1E293B" CornerRadius="8" Padding="16,12" Margin="0,0,0,14" BorderBrush="#38BDF8" BorderThickness="1">
            <StackPanel>
                <TextBlock x:Name="HeaderTitleText" Text="📋 ПРАВИЛА РАБОТЫ И ВЫПОЛНЕНИЯ ЗАДАНИЙ"
                           FontSize="15.5" FontWeight="Bold" Foreground="#38BDF8"/>
                <TextBlock x:Name="SubHeaderText" Text="Ознакомьтесь с тем, как правильно работать, что запрещено и как корректно выйти."
                           FontSize="12.5" Foreground="#CBD5E1" Margin="0,4,0,0" TextWrapping="Wrap"/>
            </StackPanel>
        </Border>

        <!-- Основной блок: 3 чётких раздела -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="0,0,0,14">
            <StackPanel>
                <!-- Блок 1: КАК НАДО -->
                <Border Background="#064E3B" CornerRadius="8" Padding="14" Margin="0,0,0,10" BorderBrush="#10B981" BorderThickness="1">
                    <StackPanel>
                        <TextBlock Text="✅ 1. КАК НАДО РАБОТАТЬ:"
                                   FontSize="13.5" FontWeight="Bold" Foreground="#34D399" Margin="0,0,0,6"/>

                        <TextBlock Text="• Добавьте все нужные аккаунты Roblox ДО запуска. На время работы сеанса список аккаунтов фиксируется."
                                   FontSize="12.5" Foreground="#ECFDF5" TextWrapping="Wrap" Margin="0,0,0,5"/>

                        <TextBlock Text="• После нажатия кнопки запуска не мешайте лаунчеру: он сам откроет окна, свернёт их для экономии видеокарты, сожмёт ОЗУ и будет нажимать клавиши Anti-AFK."
                                   FontSize="12.5" Foreground="#ECFDF5" TextWrapping="Wrap" Margin="0,0,0,5"/>

                        <TextBlock Text="• Если интернет кратковременно пропадёт (ошибка 277), ничего не нажимайте — лаунчер сам перезапустит вылетевшее окно через 15 секунд."
                                   FontSize="12.5" Foreground="#ECFDF5" TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>

                <!-- Блок 2: ЧТО ЗАПРЕЩЕНО -->
                <Border Background="#450A0A" CornerRadius="8" Padding="14" Margin="0,0,0,10" BorderBrush="#EF4444" BorderThickness="1">
                    <StackPanel>
                        <TextBlock Text="⛔ 2. ЧТО СТРОГО ЗАПРЕЩЕНО ДЕЛАТЬ:"
                                   FontSize="13.5" FontWeight="Bold" Foreground="#F87171" Margin="0,0,0,6"/>

                        <TextBlock Text="• ЗАПРЕЩЕНО закрывать отдельные окна Roblox вручную (на крестик [X], через Alt+F4 или Диспетчер задач), чтобы оставить работать только часть окон."
                                   FontSize="12.5" Foreground="#FEF2F2" TextWrapping="Wrap" Margin="0,0,0,5"/>

                        <TextBlock Text="• ЗАПРЕЩЕНО запускать сторонние окна Roblox поверх активного задания или удалять аккаунты на ходу."
                                   FontSize="12.5" Foreground="#FEF2F2" TextWrapping="Wrap" Margin="0,0,0,5"/>

                        <TextBlock Text="• Если вы закроете хотя бы одно работающее окно вручную — лаунчер воспримет это как срыв сеанса, немедленно закроет все остальные окна и назначит штрафной тайм-аут!"
                                   FontSize="12.5" FontWeight="SemiBold" Foreground="#FCA5A5" TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>

                <!-- Блок 3: ЧТО ДЕЛАТЬ, ЕСЛИ НАДО СРОЧНО ВЫЙТИ -->
                <Border Background="#1E293B" CornerRadius="8" Padding="14" BorderBrush="#F59E0B" BorderThickness="1">
                    <StackPanel>
                        <TextBlock Text="🚪 3. ЧТО ДЕЛАТЬ, ЕСЛИ ВАМ НУЖНО СРОЧНО УЙТИ:"
                                   FontSize="13.5" FontWeight="Bold" Foreground="#FBBF24" Margin="0,0,0,6"/>

                        <TextBlock Text="• Не закрывайте окна игры по одному! Откройте лаунчер и нажмите красную кнопку «⏹ Остановить все окна Roblox»."
                                   FontSize="12.5" Foreground="#F8FAFC" TextWrapping="Wrap" Margin="0,0,0,5"/>

                        <TextBlock Text="• Лаунчер аккуратно закроет все окна и освободит систему. Всё время, которое вы уже успели отработать, будет сохранено и оплачено (с небольшим удержанием 15% за досрочный переброс ваших слотов другому исполнителю)."
                                   FontSize="12.5" Foreground="#E2E8F0" TextWrapping="Wrap" Margin="0,0,0,5"/>

                        <TextBlock Text="• После досрочной остановки включится короткий тайм-аут перерыва, по окончании которого вы снова сможете запускать задания."
                                   FontSize="12.5" Foreground="#FDE68A" TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <!-- Галочка "Больше не показывать" -->
        <Border Grid.Row="2" Background="#1E293B" CornerRadius="6" Padding="12,10" Margin="0,0,0,14" BorderBrush="#334155" BorderThickness="1">
            <CheckBox x:Name="DontShowAgainCheckBox"
                      Content="Больше не показывать эти правила перед запуском (всегда доступно по кнопке «📖 Правила»)"
                      Foreground="#38BDF8" FontSize="12.5" FontWeight="SemiBold" Cursor="Hand"/>
        </Border>

        <!-- Кнопки подтверждения / отмены -->
        <Grid Grid.Row="3">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <Button x:Name="CancelBtn" Grid.Column="0" Content="Отмена"
                    Click="CancelBtn_Click"
                    Background="#334155" Foreground="#E2E8F0" FontWeight="SemiBold"
                    Padding="20,10" BorderThickness="0" Cursor="Hand"/>

            <Button x:Name="ConfirmBtn" Grid.Column="2" Content="✅ Правила понятны — Запустить окна"
                    Click="ConfirmBtn_Click"
                    Background="#16A34A" Foreground="White" FontWeight="Bold"
                    Padding="24,10" BorderThickness="0" Cursor="Hand"/>
        </Grid>
    </Grid>
</Window>
