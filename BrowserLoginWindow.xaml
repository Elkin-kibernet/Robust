<Window x:Class="RobloxWorker.Launcher.BrowserLoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="Вход или регистрация аккаунта Roblox (Изолированная сессия)"
        Height="680" Width="520"
        WindowStartupLocation="CenterOwner"
        Background="#0F172A" Foreground="#F8FAFC"
        FontFamily="Segoe UI">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Подсказка для исполнителя сверху -->
        <Border Grid.Row="0" Background="#1E293B" Padding="12,10" BorderBrush="#334155" BorderThickness="0,0,0,1">
            <StackPanel>
                <TextBlock Text="Войдите в существующий аккаунт или зарегистрируйте новый"
                           FontSize="13" FontWeight="Bold" Foreground="#38BDF8"/>
                <TextBlock Text="Как только вы войдёте, лаунчер сам сохранит аккаунт и автоматически закроет это окно."
                           FontSize="11.5" Foreground="#CBD5E1" TextWrapping="Wrap" Margin="0,2,0,0"/>
            </StackPanel>
        </Border>

        <!-- Встроенный изолированный браузер -->
        <wv2:WebView2 x:Name="LoginWebView" Grid.Row="1" DefaultBackgroundColor="#0F172A"/>
    </Grid>
</Window>